<!DOCTYPE html>
{%- set cur = site.layers | layerFor(page.url) -%}
{%- set isHome = page.url == "/" -%}
<html lang="en"{% if cur %} style="--lc-l:{{ cur.color }};--lc-d:{{ cur.color_dark }}"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or site.domain }}</title>
  <meta name="description" content="{{ cur.blurb if cur else site.tagline }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
  <style>
    /* ── Tokens ─────────────────────────────────────────────────────────────
       Source of truth: _data/site.json → brand (the SITE PROFILE).
       Light = blueprint paper; dark = tekt night navy. Layer lane colors
       arrive per page as --lc-l / --lc-d on <html>.                      */
    :root {
      --ground: {{ site.brand.light.ground }};
      --grid: {{ site.brand.light.grid }};
      --surface: {{ site.brand.light.surface }};
      --sunken: {{ site.brand.light.sunken }};
      --ink: {{ site.brand.light.ink }};
      --muted: {{ site.brand.light.muted }};
      --line: {{ site.brand.light.line }};
      --accent: {{ site.brand.light.accent }};
      --link: {{ site.brand.light.link }};
      --lc-l: {{ site.brand.light.accent }};
      --lc-d: {{ site.brand.dark.accent }};
      --lc: var(--lc-l);
      --shadow: 0 1px 0 rgba(23, 32, 51, 0.04), 0 12px 32px -18px rgba(23, 32, 51, 0.28);

      --f-display: "{{ site.brand.fonts.display }}", "Arial Narrow", "Roboto Condensed", sans-serif;
      --f-body: "{{ site.brand.fonts.body }}", -apple-system, "Segoe UI", Roboto, sans-serif;
      --f-mono: "{{ site.brand.fonts.mono }}", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;

      --measure: 46rem;
      --wide: 74rem;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --ground: {{ site.brand.dark.ground }};
        --grid: {{ site.brand.dark.grid }};
        --surface: {{ site.brand.dark.surface }};
        --sunken: {{ site.brand.dark.sunken }};
        --ink: {{ site.brand.dark.ink }};
        --muted: {{ site.brand.dark.muted }};
        --line: {{ site.brand.dark.line }};
        --accent: {{ site.brand.dark.accent }};
        --link: {{ site.brand.dark.link }};
        --lc: var(--lc-d);
        --shadow: 0 1px 0 rgba(0, 0, 0, 0.3), 0 16px 40px -20px rgba(0, 0, 0, 0.7);
        color-scheme: dark;
      }
      :root:not([data-theme="light"]) .tinted { --c: var(--c-d); }
    }
    :root[data-theme="dark"] {
      --ground: {{ site.brand.dark.ground }};
      --grid: {{ site.brand.dark.grid }};
      --surface: {{ site.brand.dark.surface }};
      --sunken: {{ site.brand.dark.sunken }};
      --ink: {{ site.brand.dark.ink }};
      --muted: {{ site.brand.dark.muted }};
      --line: {{ site.brand.dark.line }};
      --accent: {{ site.brand.dark.accent }};
      --link: {{ site.brand.dark.link }};
      --lc: var(--lc-d);
      --shadow: 0 1px 0 rgba(0, 0, 0, 0.3), 0 16px 40px -20px rgba(0, 0, 0, 0.7);
      color-scheme: dark;
    }
    :root[data-theme="dark"] .tinted { --c: var(--c-d); }
    .tinted { --c: var(--c-l); }

    /* ── Base ─────────────────────────────────────────────────────────── */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

    body {
      font-family: var(--f-body);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--ink);
      background-color: var(--ground);
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 32px 32px;
      background-position: -1px -1px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--link); }
    :focus-visible { outline: 2px solid var(--lc); outline-offset: 2px; border-radius: 2px; }
    .mono { font-family: var(--f-mono); }
    .eyebrow {
      font-family: var(--f-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* The arkitype connector: ■────── - - - - ○  */
    .rule {
      display: block;
      width: 220px;
      height: 10px;
      color: var(--lc);
      background:
        linear-gradient(currentColor, currentColor) 0 50% / 7px 7px no-repeat,
        linear-gradient(currentColor, currentColor) 0 50% / 96px 1.5px no-repeat,
        repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 8px) 100px 50% / 106px 1.5px no-repeat,
        radial-gradient(circle, transparent 0 3px, currentColor 3px 4.5px, transparent 4.5px) 100% 50% / 10px 10px no-repeat;
    }

    /* ── Header + nav ─────────────────────────────────────────────────── */
    .masthead {
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }
    .masthead-inner {
      max-width: var(--wide);
      margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex;
      align-items: baseline;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .wordmark {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: 1.7rem;
      letter-spacing: 0.02em;
      line-height: 1;
      color: var(--ink);
      text-decoration: none;
    }
    .wordmark span { font-family: var(--f-mono); font-weight: 500; font-size: 1rem; color: var(--accent); letter-spacing: 0; }
    .masthead .tagline { color: var(--muted); font-size: 0.9rem; }
    .masthead .gh {
      margin-left: auto;
      font-family: var(--f-mono);
      font-size: 0.8rem;
      color: var(--muted);
      text-decoration: none;
    }
    .masthead .gh:hover { color: var(--ink); }

    nav.site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: color-mix(in srgb, var(--surface) 92%, transparent);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
    }
    nav.site-nav ul.nav-list {
      list-style: none;
      display: flex;
      max-width: var(--wide);
      margin: 0 auto;
      padding: 0 1rem;
    }
    nav.site-nav li.nav-item { position: relative; }
    nav.site-nav li.nav-item > a {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.7rem 0.8rem 0.6rem;
      color: var(--ink);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    nav.site-nav li.nav-item > a .code {
      font-family: var(--f-mono);
      font-size: 0.72rem;
      line-height: 1;
      padding: 0.22rem 0.3rem;
      border: 1px solid var(--c, var(--line));
      color: var(--c, var(--muted));
      border-radius: 3px;
    }
    nav.site-nav li.nav-item > a:hover { color: var(--c, var(--accent)); }
    nav.site-nav li.nav-item > a.active { border-bottom-color: var(--c, var(--ink)); }
    nav.site-nav li.nav-item > a.active .code { background: var(--c); color: var(--surface); }
    nav.site-nav li.downloads { margin-left: auto; }

    nav.site-nav ul.sub {
      list-style: none;
      position: absolute;
      left: 0;
      top: 100%;
      min-width: 250px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 2px solid var(--c, var(--accent));
      box-shadow: var(--shadow);
      display: none;
      padding: 0.4rem 0;
    }
    nav.site-nav li.downloads ul.sub { left: auto; right: 0; }
    nav.site-nav li.nav-item:hover > ul.sub,
    nav.site-nav li.nav-item:focus-within > ul.sub { display: block; }
    nav.site-nav ul.sub a {
      display: block;
      padding: 0.35rem 1rem;
      color: var(--muted);
      text-decoration: none;
      font-size: 0.86rem;
    }
    nav.site-nav ul.sub a:hover { color: var(--ink); background: var(--sunken); }

    nav.site-nav details.mobile-menu { display: none; }
    @media (max-width: 900px) {
      nav.site-nav ul.nav-list { display: none; }
      nav.site-nav details.mobile-menu { display: block; padding: 0.5rem 1.25rem; }
      nav.site-nav details.mobile-menu summary {
        cursor: pointer;
        font-family: var(--f-mono);
        font-size: 0.85rem;
        color: var(--ink);
        padding: 0.3rem 0;
      }
      nav.site-nav details.mobile-menu > ul { list-style: none; padding: 0.4rem 0 0.8rem; display: grid; gap: 0.2rem; }
      nav.site-nav details.mobile-menu li > a {
        display: flex; gap: 0.5rem; align-items: center;
        padding: 0.35rem 0; color: var(--ink); font-weight: 600; text-decoration: none;
      }
      nav.site-nav details.mobile-menu li > a .code { font-family: var(--f-mono); font-size: 0.75rem; color: var(--c, var(--muted)); }
      nav.site-nav details.mobile-menu ul ul { list-style: none; padding-left: 1rem; border-left: 1px dashed var(--line); margin: 0 0 0.4rem 0.3rem; }
      nav.site-nav details.mobile-menu ul ul a { font-weight: 400; font-size: 0.88rem; color: var(--muted); padding: 0.2rem 0; }
    }

    /* ── Hero ─────────────────────────────────────────────────────────── */
    .hero {
      max-width: var(--wide);
      margin: 0 auto;
      padding: 3rem 1.5rem 2.25rem;
      display: grid;
      gap: 0.9rem;
    }
    .hero h1 {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: clamp(2.6rem, 6vw, 4.2rem);
      line-height: 0.95;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: var(--ink);
      text-wrap: balance;
    }
    .hero .eyebrow { color: var(--lc); }
    .hero .lead { max-width: 40rem; font-size: 1.15rem; color: var(--muted); text-wrap: pretty; }
    .hero .lead strong { color: var(--ink); font-weight: 600; }

    .home .hero { padding-top: 3.5rem; grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); column-gap: 3rem; align-items: end; }
    .home .hero h1 { font-size: clamp(4rem, 11vw, 7.5rem); }
    .home .hero .intro { display: grid; gap: 1rem; }
    @media (max-width: 900px) { .home .hero { grid-template-columns: 1fr; row-gap: 1.75rem; } }

    .install {
      background: var(--surface);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      border-radius: 6px;
      display: grid;
    }
    .install .row { padding: 0.8rem 1rem; display: grid; gap: 0.35rem; }
    .install .row + .row { border-top: 1px dashed var(--line); }
    .install .cmd {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--f-mono);
      font-size: 0.86rem;
    }
    .hero > *, .install, .install .row { min-width: 0; }
    .install .cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; color: var(--ink); }
    .install .cmd code::before { content: "$ "; color: var(--muted); }
    .install .cmd.ps code::before { content: "PS> "; }
    .copy {
      font: inherit;
      font-size: 0.75rem;
      padding: 0.25rem 0.55rem;
      border: 1px solid var(--line);
      background: var(--sunken);
      color: var(--ink);
      border-radius: 4px;
      cursor: pointer;
    }
    .copy:hover { border-color: var(--accent); }

    /* The five layers — modeled on the arkitype cover's connected cards */
    .layers {
      max-width: var(--wide);
      margin: 0 auto;
      padding: 0 1.5rem 2.5rem;
      list-style: none;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .layers li { position: relative; display: flex; }
    .layers li + li::before {
      content: "";
      position: absolute;
      left: -1.5rem;
      top: 2.1rem;
      width: 1.5rem;
      height: 1.5px;
      background: var(--line);
    }
    .layers li + li::after {
      content: "";
      position: absolute;
      left: calc(-0.75rem - 5px);
      top: calc(2.1rem - 4.25px);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 1.5px solid var(--muted);
      background: var(--ground);
    }
    .layer-card {
      flex: 1;
      display: grid;
      align-content: start;
      gap: 0.4rem;
      padding: 1rem 1.1rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 6px;
      text-decoration: none;
      color: var(--ink);
      transition: border-color 0.15s, transform 0.15s;
    }
    .layer-card:hover { border-color: var(--c); transform: translateY(-2px); }
    @media (prefers-reduced-motion: reduce) { .layer-card { transition: none; } .layer-card:hover { transform: none; } }
    .layer-card .folder { font-family: var(--f-mono); font-size: 0.95rem; font-weight: 500; color: var(--c); }
    .layer-card .name { font-family: var(--f-display); font-weight: 600; font-size: 1.5rem; line-height: 1.05; text-transform: uppercase; }
    .layer-card .tekt { font-family: var(--f-mono); font-size: 0.72rem; color: var(--muted); }
    .layer-card .blurb { font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
    .layer-card .tools { font-family: var(--f-mono); font-size: 0.7rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 0.5rem; margin-top: 0.2rem; }
    @media (max-width: 1000px) {
      .layers { grid-template-columns: 1fr; gap: 0.75rem; }
      .layers li + li::before, .layers li + li::after { display: none; }
      .layer-card { grid-template-columns: 9rem 1fr; column-gap: 1rem; }
      .layer-card .folder, .layer-card .name, .layer-card .tekt { grid-column: 1; }
      .layer-card .blurb, .layer-card .tools { grid-column: 2; grid-row: 1 / span 3; }
      .layer-card .tools { grid-row: 3; }
    }
    @media (max-width: 560px) {
      .layer-card { grid-template-columns: 1fr; }
      .layer-card .blurb, .layer-card .tools { grid-column: 1; grid-row: auto; }
    }

    /* ── Sheet: the document, drawn on the blueprint table ─────────────── */
    .desk {
      max-width: var(--wide);
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 2.5rem;
      align-items: start;
    }
    @media (max-width: 1100px) { .desk { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }

    .sheet {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 6px;
      box-shadow: var(--shadow);
      min-width: 0;
    }
    main {
      padding: 2.5rem clamp(1.25rem, 5vw, 3.5rem) 3rem;
      max-width: calc(var(--measure) + 7rem);
    }

    main h1 { display: none; } /* the page title lives in the hero */
    main h2, main h3, main h4 { line-height: 1.25; text-wrap: balance; color: var(--ink); scroll-margin-top: 4rem; }
    main h2 {
      font-size: 1.45rem;
      font-weight: 600;
      margin: 2.75rem 0 1rem;
      padding-bottom: 0.9rem;
      position: relative;
    }
    main h2::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 220px;
      height: 10px;
      color: var(--lc);
      background:
        linear-gradient(currentColor, currentColor) 0 50% / 7px 7px no-repeat,
        linear-gradient(currentColor, currentColor) 0 50% / 96px 1.5px no-repeat,
        repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 8px) 100px 50% / 106px 1.5px no-repeat,
        radial-gradient(circle, transparent 0 3px, currentColor 3px 4.5px, transparent 4.5px) 100% 50% / 10px 10px no-repeat;
    }
    main > h2:first-of-type { margin-top: 0.5rem; }
    main h3 { font-size: 1.12rem; font-weight: 600; margin: 2rem 0 0.5rem; }
    main h4 { font-size: 1rem; font-weight: 600; margin: 1.5rem 0 0.4rem; }

    main p, main ul, main ol, main blockquote, main table, main pre { max-width: var(--measure); }
    main p { margin: 0.8rem 0; }
    main ul, main ol { padding-left: 1.3rem; margin: 0.8rem 0; }
    main li { margin: 0.3rem 0; }
    main li::marker { color: var(--lc); }
    main strong { font-weight: 600; }
    main a { color: var(--link); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--link) 35%, transparent); text-underline-offset: 3px; }
    main a:hover { text-decoration-color: currentColor; }

    main img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 1.5rem 0;
      border: 1px solid var(--line);
      border-radius: 6px;
    }

    main code {
      font-family: var(--f-mono);
      font-size: 0.86em;
      background: var(--sunken);
      border: 1px solid var(--line);
      padding: 0.05em 0.35em;
      border-radius: 3px;
    }
    main pre {
      background: var(--sunken);
      border: 1px solid var(--line);
      border-left: 3px solid var(--lc);
      border-radius: 4px;
      padding: 0.9rem 1.1rem;
      overflow-x: auto;
      margin: 1.1rem 0;
      font-size: 0.9rem;
      line-height: 1.55;
    }
    main pre code { background: none; border: 0; padding: 0; font-size: 0.86rem; }

    .table-wrap { overflow-x: auto; margin: 1.1rem 0; max-width: var(--measure); }
    main table { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; margin: 0; }
    main th {
      font-family: var(--f-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1.5px solid var(--ink);
      white-space: nowrap;
    }
    main td { padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
    main tr:hover td { background: var(--sunken); }

    main hr { border: 0; border-top: 1px dashed var(--line); margin: 2.5rem 0; }
    main blockquote {
      border-left: 3px solid var(--lc);
      padding: 0.25rem 0 0.25rem 1rem;
      color: var(--muted);
      margin: 1.2rem 0;
    }

    figure.diagram {
      margin: 1.25rem 0;
      padding: 1.25rem;
      border: 1px dashed var(--line);
      border-radius: 6px;
      background-color: var(--surface);
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 16px 16px;
      overflow-x: auto;
    }
    figure.diagram .mermaid { display: flex; justify-content: center; min-width: min-content; }
    figure.diagram .mermaid:not([data-processed]) { font-family: var(--f-mono); font-size: 0.8rem; white-space: pre; color: var(--muted); justify-content: flex-start; }

    /* Prev / next along the 00 → 04 build order */
    .pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-top: 1px solid var(--line);
    }
    .pager a {
      padding: 1rem clamp(1.25rem, 5vw, 3.5rem);
      text-decoration: none;
      color: var(--ink);
      display: grid;
      gap: 0.15rem;
    }
    .pager a:hover { background: var(--sunken); }
    .pager a.next { text-align: right; grid-column: 2; border-left: 1px solid var(--line); }
    .pager .t { font-family: var(--f-display); font-size: 1.25rem; font-weight: 600; text-transform: uppercase; }
    .pager .t .code { font-family: var(--f-mono); font-size: 0.85rem; color: var(--c); margin-right: 0.35rem; }

    /* Engineering-drawing title block */
    .titleblock {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      border-top: 1.5px solid var(--ink);
      font-size: 0.82rem;
    }
    .titleblock > div { padding: 0.55rem 0.9rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; gap: 0.1rem; }
    .titleblock .k { font-family: var(--f-mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .titleblock .v { font-family: var(--f-mono); color: var(--ink); overflow-wrap: anywhere; }
    .titleblock .v a { color: inherit; }
    .titleblock .credit { grid-column: 1 / -1; border-right: 0; border-bottom: 0; color: var(--muted); font-size: 0.8rem; }

    /* On-page contents, pinned beside the sheet */
    .toc { position: sticky; top: 4.5rem; font-size: 0.84rem; }
    .toc .eyebrow { display: block; margin-bottom: 0.6rem; }
    .toc ol { list-style: none; border-left: 1px solid var(--line); display: grid; }
    .toc a { display: block; padding: 0.25rem 0 0.25rem 0.8rem; margin-left: -1px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; line-height: 1.35; }
    .toc a:hover { color: var(--ink); }
    .toc a.on { color: var(--ink); border-left-color: var(--lc); }

    @media (max-width: 600px) {
      .masthead .tagline, .masthead .gh { display: none; }
      .hero { padding-top: 2rem; }
      .desk { padding: 0 0.75rem 3rem; }
    }
  </style>
</head>
<body class="{{ 'home' if isHome else ('layer-' + cur.code if cur else 'page') }}">

  <header class="masthead">
    <div class="masthead-inner">
      <a class="wordmark" href="/">TEKT<span>.md</span></a>
      <span class="tagline">{{ site.tagline }}</span>
      <a class="gh" href="{{ site.repo }}">github.com/xingh/tekt.md ↗</a>
    </div>
  </header>

  <nav class="site-nav" aria-label="Site">
    <ul class="nav-list">
      {% for p in site.nav %}
      {% set L = site.layers | layerFor(p.url) %}
      <li class="nav-item{% if L %} tinted{% endif %}{% if p.title == 'Downloads' %} downloads{% endif %}"{% if L %} style="--c-l:{{ L.color }};--c-d:{{ L.color_dark }}"{% endif %}>
        <a href="{{ p.url }}"{% if page.url == p.url %} class="active" aria-current="page"{% endif %}>{% if p.code %}<span class="code">{{ p.code }}</span>{% endif %}{{ p.title }}</a>
        {% if p.sections and p.sections.length %}
        <ul class="sub">
          {% for s in p.sections %}
          <li><a href="{{ s.href or (p.url + '#' + s.slug) }}">{{ s.label }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>

    <details class="mobile-menu">
      <summary>Menu · {{ (cur.code + " " + cur.name) if cur else ("Home" if isHome else title) }}</summary>
      <ul>
        {% for p in site.nav %}
        {% set L = site.layers | layerFor(p.url) %}
        <li{% if L %} class="tinted" style="--c-l:{{ L.color }};--c-d:{{ L.color_dark }}"{% endif %}>
          <a href="{{ p.url }}"{% if page.url == p.url %} aria-current="page"{% endif %}>{% if p.code %}<span class="code">{{ p.code }}</span>{% endif %}{{ p.title }}</a>
          {% if p.sections and p.sections.length %}
          <ul>
            {% for s in p.sections %}
            <li><a href="{{ s.href or (p.url + '#' + s.slug) }}">{{ s.label }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
  </nav>

  {% if isHome %}
  <section class="hero" aria-labelledby="hero-title">
    <div class="intro">
      <span class="eyebrow">distribution · catalog {{ site.catalog_version }} · {{ site.pillars | join(" · ") }}</span>
      <h1 id="hero-title">Tekt</h1>
      <span class="rule" aria-hidden="true"></span>
      <p class="lead">Bootstrap open-source AI on <strong>your hardware</strong>, with <strong>your keys</strong>, in one script: dev tooling, workspace sync, local models, agent runtimes, an MCP hub, and self-hosted chat and workflow UIs.</p>
    </div>
    <div class="install" aria-label="Install">
      <div class="row">
        <span class="eyebrow">macOS · Linux · WSL2</span>
        <div class="cmd"><code>{{ site.install.unix }}</code><button class="copy" type="button" data-copy="{{ site.install.unix }}">Copy</button></div>
      </div>
      <div class="row">
        <span class="eyebrow">Windows PowerShell</span>
        <div class="cmd ps"><code>{{ site.install.windows }}</code><button class="copy" type="button" data-copy="{{ site.install.windows }}">Copy</button></div>
      </div>
    </div>
  </section>

  <ol class="layers" aria-label="The five arkitype layers, in build order">
    {% for l in site.layers %}
    <li class="tinted" style="--c-l:{{ l.color }};--c-d:{{ l.color_dark }}">
      <a class="layer-card" href="{{ l.url }}">
        <span class="folder">{{ l.code }}-{{ l.slug }}/</span>
        <span class="name">{{ l.name }}</span>
        <span class="tekt">{{ l.tekt }}</span>
        <span class="blurb">{{ l.blurb }}</span>
        <span class="tools">{{ l.tools | join(" · ") }}</span>
      </a>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <section class="hero">
    {% if cur %}
    <span class="eyebrow">Layer {{ cur.code }} of 04 · {{ cur.tekt }}</span>
    <h1>{{ cur.name }}</h1>
    <span class="rule" aria-hidden="true"></span>
    <p class="lead">{{ cur.blurb }}</p>
    {% else %}
    <span class="eyebrow">{{ site.domain }}</span>
    <h1>{{ title }}</h1>
    <span class="rule" aria-hidden="true"></span>
    {% endif %}
  </section>
  {% endif %}

  <div class="desk">
    <article class="sheet">
      <main>
        {{ content | safe }}
      </main>

      {% if cur or isHome %}
      {% set prevL = site.layers | layerAt(page.url, -1) %}
      {% set nextL = site.layers | layerAt(page.url, 1) %}
      <nav class="pager" aria-label="Layer order">
        {% if prevL %}<a class="prev tinted" href="{{ prevL.url }}" style="--c-l:{{ prevL.color }};--c-d:{{ prevL.color_dark }}"><span class="eyebrow">← Previous layer</span><span class="t"><span class="code">{{ prevL.code }}</span>{{ prevL.name }}</span></a>{% endif %}
        {% if nextL %}<a class="next tinted" href="{{ nextL.url }}" style="--c-l:{{ nextL.color }};--c-d:{{ nextL.color_dark }}"><span class="eyebrow">Next layer →</span><span class="t"><span class="code">{{ nextL.code }}</span>{{ nextL.name }}</span></a>{% endif %}
      </nav>
      {% endif %}

      <footer class="titleblock">
        <div><span class="k">Project</span><span class="v">{{ site.domain }}</span></div>
        <div><span class="k">Sheet</span><span class="v">{{ (cur.code + " / 04") if cur else "index" }}</span></div>
        <div><span class="k">Layer</span><span class="v">{{ cur.tekt if cur else "all" }}</span></div>
        <div><span class="k">Catalog</span><span class="v">{{ site.catalog_version }}</span></div>
        <div><span class="k">Source</span><span class="v"><a href="{{ site.repo }}/blob/main/{{ page.inputPath | replace('./', '') }}">{{ page.inputPath | replace('./', '') }}</a></span></div>
        <div class="credit">Every tool credits its upstream creators; see <a href="/tekt.catalog.yaml">tekt.catalog.yaml</a>. Built with Eleventy · maintained by <a href="https://anant.us">Anant Corporation</a>.</div>
      </footer>
    </article>

    <aside class="toc" aria-label="On this page">
      <span class="eyebrow">On this sheet</span>
      <ol id="toc"></ol>
    </aside>
  </div>

  <script>
    (function () {
      // Heading anchors. Slug rule must stay in sync with nav slugs in
      // _data/site.json: lowercase → strip non-alphanumerics (keep spaces and
      // hyphens) → collapse whitespace to single hyphens.
      var slug = function (t) {
        return t.toLowerCase().replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-");
      };
      var heads = document.querySelectorAll("main h2, main h3");
      heads.forEach(function (h) { if (!h.id) h.id = slug(h.textContent); });

      // Contents rail from the h2s.
      var toc = document.getElementById("toc");
      var links = [];
      document.querySelectorAll("main h2").forEach(function (h) {
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.textContent.replace(/^\d+\.\s*/, "");
        li.appendChild(a);
        toc.appendChild(li);
        links.push([h, a]);
      });
      if (!links.length) document.querySelector(".toc").hidden = true;
      var mark = function () {
        var on = null;
        links.forEach(function (p) { if (p[0].getBoundingClientRect().top < 120) on = p[1]; });
        links.forEach(function (p) { p[1].classList.toggle("on", p[1] === on); });
      };
      document.addEventListener("scroll", mark, { passive: true });
      mark();

      // Tables scroll inside their own box, never the page.
      document.querySelectorAll("main table").forEach(function (t) {
        var w = document.createElement("div");
        w.className = "table-wrap";
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
      });

      // Copy buttons on the install commands.
      document.querySelectorAll("[data-copy]").forEach(function (b) {
        b.addEventListener("click", function () {
          navigator.clipboard.writeText(b.dataset.copy).then(function () {
            b.textContent = "Copied";
            setTimeout(function () { b.textContent = "Copy"; }, 1600);
          });
        });
      });

      // ```mermaid fences → diagram figures (rendered below).
      document.querySelectorAll("main pre > code.language-mermaid").forEach(function (c) {
        var fig = document.createElement("figure");
        fig.className = "diagram";
        var d = document.createElement("div");
        d.className = "mermaid";
        d.dataset.src = c.textContent;
        d.textContent = c.textContent;
        fig.appendChild(d);
        c.parentNode.replaceWith(fig);
      });

      if (location.hash) {
        var target = document.getElementById(location.hash.slice(1));
        if (target) target.scrollIntoView();
      }
    })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.min.js" defer></script>
  <script>
    // Theme Mermaid from the live CSS tokens so diagrams follow light/dark.
    window.addEventListener("load", function () {
      if (!window.mermaid || !document.querySelector(".mermaid")) return;
      var css = getComputedStyle(document.documentElement);
      var v = function (n) { return css.getPropertyValue(n).trim(); };
      var render = function () {
        css = getComputedStyle(document.documentElement);
        document.querySelectorAll(".mermaid").forEach(function (d) {
          d.removeAttribute("data-processed");
          d.innerHTML = "";
          d.textContent = d.dataset.src;
        });
        mermaid.initialize({
          startOnLoad: false,
          theme: "base",
          flowchart: { useMaxWidth: false },
          fontFamily: v("--f-mono"),
          themeVariables: {
            fontSize: "13px",
            background: v("--surface"),
            primaryColor: v("--surface"),
            primaryBorderColor: v("--lc"),
            primaryTextColor: v("--ink"),
            secondaryColor: v("--sunken"),
            tertiaryColor: v("--sunken"),
            clusterBkg: v("--sunken"),
            clusterBorder: v("--line"),
            lineColor: v("--muted"),
            textColor: v("--ink"),
            edgeLabelBackground: v("--surface"),
            nodeBorder: v("--lc")
          }
        });
        mermaid.run({ querySelector: ".mermaid" });
      };
      render();
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      if (mq.addEventListener) mq.addEventListener("change", render);
      new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    });
  </script>
</body>
</html>
